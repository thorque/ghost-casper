{{!< default}}

{{#contentFor "is_hub"}}Hello World{{/contentFor}}
<main id="site-main" class="site-main outer">
  <div class="gh-hub-container">
    <section class="gh-hub-header">
      <div class="gh-hub-header-content">
        {{#if @site.logo}}
          <img class="gh-hub-logo" src="{{@site.logo}}" alt="{{@site.title}}">
        {{/if}}
        <h1 class="gh-hub-title">{{@site.title}}</h1>
        <p class="gh-hub-description">{{@site.description}}</p>
      </div>
      {{#has any="@custom.hub_feature_image, @site.cover_image"}}
        <div class="gh-hub-header-image">
          {{#if @custom.hub_feature_image}}
            <img
              srcset="{{img_url @custom.hub_feature_image size="s"}} 300w,
                      {{img_url @custom.hub_feature_image size="m"}} 600w,
                      {{img_url @custom.hub_feature_image size="l"}} 1000w,
                      {{img_url @custom.hub_feature_image size="xl"}} 2000w"
              sizes="100vw"
              src="{{img_url @custom.hub_feature_image size="xl"}}"
              alt="{{@site.title}}"/>
          {{else}}
            <img
              srcset="{{img_url @site.cover_image size="s"}} 300w,
                      {{img_url @site.cover_image size="m"}} 600w,
                      {{img_url @site.cover_image size="l"}} 1000w,
                      {{img_url @site.cover_image size="xl"}} 2000w"
              sizes="100vw"
              src="{{img_url @site.cover_image size="xl"}}"
              alt="{{@site.title}}"/>
          {{/if}}
        </div>
      {{/has}}
    </section>
    {{> "components/social-media-card"}}
    {{#get "posts"  limit="6" as |more_posts|}}
      {{#if more_posts}}
        <aside class="read-more-wrap outer gh-hub-latest-posts">
          <h2>Latest Posts</h2>
            <div class="read-more inner">
                {{#foreach more_posts}}
                    {{> "post-card"}}
                {{/foreach}}
            </div>
        </aside>
      {{/if}}
    {{/get}}
    {{#if @site.members_enabled}}
      {{#unless @member}}
        <section class="footer-cta outer">
          <div class="inner">
            {{#if @custom.email_signup_text}}<h2 class="footer-cta-title">{{@custom.email_signup_text}}</h2>{{/if}}
            <a class="footer-cta-button" href="#/portal" data-portal>
              <div class="footer-cta-input">Enter your email</div>
              <span>Subscribe</span>
            </a>
          </div>
        </section>
      {{/unless}}
    {{/if}}
  </div>
</main>
