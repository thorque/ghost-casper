<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="cc--darkmode dark-mode"{{else match @custom.color_scheme "Auto"}} class="auto-color"{{/match}}>
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script>
        (()=>{const m=window.matchMedia('(prefers-color-scheme: dark)'),u=()=>document.documentElement.classList[m.matches?'add':'remove']('cc--darkmode');u();m.addEventListener('change',u)})();
    </script>

    <link rel="preload" as="style" href="{{asset "built/screen.css"}}" />
    <link rel="preload" as="style" href="{{asset "built/cookieconsent.css"}}" />
    <link rel="preload" as="script" href="{{asset "built/casper.js"}}" />

    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "built/cookieconsent.css"}}" />

    <style>
        :root {
            --gh-font-heading: '{{ @custom.title_font }}';
            --gh-font-body: '{{ @custom.body_font }}';
            --font-mono: Menlo, Courier, monospace;
        }
    </style>
    {{ghost_head}}

</head>
<body class="{{body_class}} is-head-{{#match @custom.navigation_layout "Logo on cover"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}

{{#if @custom.show_publication_cover}} has-cover{{/if}}">
<div class="viewport">
  <header id="gh-head" class="gh-head outer{{#match @custom.header_style "Hidden"}} is-header-hidden{{/match}}">
        <div class="gh-head-inner inner">
            <div class="gh-head-brand">
                <button class="gh-burger" aria-label="Main Menu"></button>
            </div>

            <div class="gh-head-actions">
                {{#unless @site.members_enabled}}
                    
                {{else}}
                    <div class="gh-head-members">
                        {{#unless @member}}
                            {{#unless @site.members_invite_only}}
                                <a class="gh-head-link" href="#/portal/signin" data-portal="signin">Sign in</a>
                                <a class="gh-head-button" href="#/portal/signup" data-portal="signup">Subscribe</a>
                            {{else}}
                                <a class="gh-head-button" href="#/portal/signin" data-portal="signin">Sign in</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-head-button" href="#/portal/account" data-portal="account">Account</a>
                        {{/unless}}
                    </div>
                {{/unless}}
            </div>
        </div>
  </header>
  <main id="site-main" class="site-main outer">
    <div class="gh-hub-container">
        <section class="gh-hub-header">
            <div class="gh-hub-header-content">
                {{#if @site.logo}}
                  <img class="gh-hub-logo" src="{{@site.logo}}" alt="{{@site.title}}">
                {{/if}}
                <h1 class="gh-hub-title">{{@site.title}}</h1>
                <p class="gh-hub-description">{{@site.description}}</p>
                {{> "components/social-media-card"}}
            </div>
            {{!-- Image-Container nur anzeigen, wenn ein Bild existiert --}}
            {{#has any="@custom.hub_feature_image, @site.cover_image"}}
              <div class="gh-hub-header-image">
                {{!-- Priorisierung der Bilder --}}
                {{#if @custom.hub_feature_image}}
                  <img
                    srcset="{{img_url @custom.hub_feature_image size="s"}} 300w,
                            {{img_url @custom.hub_feature_image size="m"}} 600w,
                            {{img_url @custom.hub_feature_image size="l"}} 1000w,
                            {{img_url @custom.hub_feature_image size="xl"}} 2000w"
                    sizes="100vw"
                    src="{{img_url @custom.hub_feature_image size="xl"}}"
                    alt="{{@site.title}}"
                  />
                  <img src="{{@custom.hub_feature_image}}" alt="{{@site.title}}">
                {{else}}
                  <img
                    srcset="{{img_url @site.cover_image size="s"}} 300w,
                            {{img_url @site.cover_image size="m"}} 600w,
                            {{img_url @site.cover_image size="l"}} 1000w,
                            {{img_url @site.cover_image size="xl"}} 2000w"
                    sizes="100vw"
                    src="{{img_url @site.cover_image size="xl"}}"
                    alt="{{@site.title}}"
                  />
                {{/if}}
              </div>
            {{/has}}
        </section>
        {{#get "posts"  limit="6" as |more_posts|}}
        {{#if more_posts}}
          <aside class="read-more-wrap outer gh-hub-latest-posts">
            <h2>Latest Posts</h2>
              <div class="read-more inner">
                
                  {{#foreach more_posts}}
                      {{> "post-card"}}
                  {{/foreach}}
              </div>
          </aside>
        {{/if}}

    {{/get}}
        {{#if @site.members_enabled}}
        {{#unless @member}}
          
              <section class="footer-cta outer">
                  <div class="inner">
                      {{#if @custom.email_signup_text}}<h2 class="footer-cta-title">{{@custom.email_signup_text}}</h2>{{/if}}
                      <a class="footer-cta-button" href="#/portal" data-portal>
                          <div class="footer-cta-input">Enter your email</div>
                          <span>Subscribe</span>
                      </a>
                  </div>
              </section>
          
          {{/unless}}
          {{/if}}
    </div>
  </main>
  <footer class="site-footer outer">
    <div class="inner">
      <section class="copyright"><a href="{{@site.url}}">{{@site.title}}</a> &copy; {{date format="YYYY"}}</section>
      <nav class="site-footer-nav">
        {{navigation type="secondary"}}
      </nav>
      <div class="gh-powered-by"><a href="https://ghost.org/" target="_blank" rel="noopener">Powered by Ghost</a></div>
    </div>
  </footer>
</div>

{{!-- Scripts - handle member signups, responsive videos, infinite scroll, floating headers, and galleries --}}
<script src="{{asset "built/cookieconsent.umd.js"}}"></script>
<script src="{{asset "built/jquery.min.js"}}"></script>
<script src="{{asset "built/casper.js"}}"></script>
<script>
$(document).ready(function () {
    $('.gh-burger').click(function () {
        $('body').toggleClass('gh-head-open');
    });
    $(".gh-content").fitVids();
});
</script>
{{ghost_foot}}
</body>
</html>

  