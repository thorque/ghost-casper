<footer class="site-footer outer">
  <div class="inner">
    <section class="copyright">
      <a href="{{@site.url}}">{{@site.title}}</a> &copy; {{date format="YYYY"}}
      {{#if @site.description}}
        <br/>{{@site.description}}
      {{/if}}
    </section>
    <nav class="site-footer-nav">
      {{navigation type="secondary"}}
    </nav>
    <div class="footer-social-icons gh-social-icon-small">{{> "components/social-media-card"}}</div>
  </div>
</footer>