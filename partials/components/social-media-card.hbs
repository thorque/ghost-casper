{{!-- This is a partial file used to generate a social media "card" to show the configured social media profiles. --}}

<div class="gh-hub-social-links">
  {{#if @custom.instagram_profile}}
    <a href="{{@custom.instagram_profile}}" 
       target="_blank" 
       rel="noopener" 
       class="social-icon-link" 
       aria-label="{{@site.title}} auf Instagram"
       title="{{@site.title}} @ Instagram">
      <div class="social-icon instagram">
        {{> "icons/instagram"}}
      </div>
      <span class="sr-only">Instagram</span>
    </a>
  {{/if}}
  
