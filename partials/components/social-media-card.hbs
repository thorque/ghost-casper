{{!-- This is a partial file used to generate a social media "card" to show the configured social media profiles. --}}

<div class="gh-hub-social-links">
  {{#if @custom.instagram_profile}}
    <a href="{{@custom.instagram_profile}}" target="_blank" rel="noopener" class="social-card">
      <div class="social-card-icon instagram">
        <div class="social-icon-letter">IG</div>
      </div>
      <div class="social-card-content">
        <div class="social-card-title">Instagram</div>
      </div>
    </a>
  {{/if}}
  
  {{#if @custom.bluesky_profile}}
    <a href="{{@custom.bluesky_profile}}" target="_blank" rel="noopener" class="social-card">
